<?xml version="1.0"?>
<package format="2">
  <name>hero_chassis_controller</name>
  <version>0.1.0</version>
  <description>ROS 1 package for a four-wheel mecanum chassis controller.</description>

  <maintainer email="1765604419@qq.com">Jijie Deng</maintainer>
  <author email="1765604419@qq.com">Jijie Deng</author>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>control_toolbox</depend>
  <depend>controller_interface</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>nav_msgs</depend>
